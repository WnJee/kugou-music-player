{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuGouPlayer",
  "version": "0.3.6",
  "identifier": "com.kugou.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "酷狗无损播放器",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 540,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNjEyQjg3NjNBQzA3NDUKUldSRkI2eGpoeXRoUHdvSFg0QnQ1ZnVCS0pyaGE0QUhiRDY4NUhrSG5WL2c3UWZGTHdXSTJuSTIK",
      "endpoints": [
        "https://github.com/WnJee/kugou-music-player/releases/latest/download/latest.json"
      ]
    }
  }
}
