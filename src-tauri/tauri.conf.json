{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuGouPlayer",
  "version": "1.0.0",
  "identifier": "com.kugou.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "酷狗无损播放器",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 540,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
